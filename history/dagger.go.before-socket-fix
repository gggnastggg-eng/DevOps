package main

import (
	"context"
	"fmt"
	"os"
	"os/exec"
	"strings"

 dagger "uptime-kuma-monitoring/internal/dagger"

)



type UptimeKumaMonitoring struct {
	DockerSocket *dagger.Socket
}

func (m *UptimeKumaMonitoring) docker(ctx context.Context, args ...string) (string, error) {
	sock := m.DockerSocket
	ctr := dag.Container().
		From("docker:27-cli").
		WithUnixSocket("/var/run/docker.sock", sock).
		WithExec(append([]string{"docker"}, args...))
	out, err := ctr.Stdout(ctx)
	if err != nil {
		stderr, _ := ctr.Stderr(ctx)
		return "", fmt.Errorf("docker %s failed: %s: %w", strings.Join(args, " "), stderr, err)
	}
	return out, nil
}

func (m *UptimeKumaMonitoring) DeployApp(ctx context.Context) (string, error) {
	if _, err := m.docker(ctx, "compose", "-f", "compose.app.yml", "up", "-d"); err != nil {
		return "", err
	}
	return "Application layer deployed. Kuma: http://localhost:3001", nil
}

func (m *UptimeKumaMonitoring) DeployMonitoring(ctx context.Context) (string, error) {
	if _, err := m.docker(ctx, "network", "inspect", "kuma-app"); err != nil {
		return "", fmt.Errorf("run deploy-app first so kuma-app network exists: %w", err)
	}
	if _, err := m.docker(ctx, "compose", "-f", "compose.monitoring.yml", "up", "-d"); err != nil {
		return "", err
	}
	return "Monitoring layer deployed. Prometheus: http://localhost:9090; Grafana: http://localhost:3000", nil
}

func (m *UptimeKumaMonitoring) ConfigureGrafana(ctx context.Context) (string, error) {
	// Grafana provisioning files are mounted read-only by Compose. This command
	// triggers a provisioning reload via restart, then checks the API endpoint.
	if _, err := m.docker(ctx, "restart", "kuma-grafana"); err != nil {
		return "", err
	}
	// Avoid embedding credentials in source. Defaults are for local demo only.
	user := os.Getenv("GRAFANA_ADMIN_USER")
	pass := os.Getenv("GRAFANA_ADMIN_PASSWORD")
	if user == "" { user = "admin" }
	if pass == "" { pass = "change-me-grafana-password" }
	cmd := exec.CommandContext(ctx, "curl", "-fsS", "-u", user+":"+pass, "http://localhost:3000/api/health")
	out, err := cmd.CombinedOutput()
	if err != nil {
		return "", fmt.Errorf("Grafana API health check failed (is curl installed on host?): %s: %w", string(out), err)
	}
	return "Grafana provisioning reloaded; API health: " + strings.TrimSpace(string(out)), nil
}

func (m *UptimeKumaMonitoring) DeployAll(ctx context.Context) (string, error) {
	if _, err := m.DeployApp(ctx); err != nil { return "", err }
	if _, err := m.DeployMonitoring(ctx); err != nil { return "", err }
	if _, err := m.ConfigureGrafana(ctx); err != nil { return "", err }
	if _, err := m.docker(ctx, "ps", "--format", "{{.Names}} {{.Status}}"); err != nil { return "", err }
	return "All layers deployed and Grafana health checked. Verify container list with: docker ps", nil
}

func (m *UptimeKumaMonitoring) ChaosTest(ctx context.Context) (string, error) {
	if _, err := m.docker(ctx, "stop", "uptime-kuma"); err != nil { return "", err }
	// Restart policy is exercised by Docker after manual stop is followed by explicit start.
	if _, err := m.docker(ctx, "start", "uptime-kuma"); err != nil { return "", err }
	return "Chaos smoke test: Uptime Kuma was stopped and started. Check dashboard probe_success returns to 1.", nil
}

func (m *UptimeKumaMonitoring) Status(ctx context.Context) (string, error) {
	return m.docker(ctx, "ps", "--format", "{{.Names}} {{.Status}}")
}
